{
  "name": "nipa-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Nipa Cloud from your terminal: log in with MFA once, then run openstack and terraform with the session.",
  "keywords": [
    "cli",
    "keystone",
    "mfa",
    "nipa-cloud",
    "openstack",
    "terraform",
    "totp"
  ],
  "homepage": "https://github.com/PunGrumpy/nipa-cli#readme",
  "bugs": "https://github.com/PunGrumpy/nipa-cli/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PunGrumpy/nipa-cli.git"
  },
  "bin": {
    "nipa": "./src/index.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --compile --minify --outfile dist/nipa",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "changeset": "changeset",
    "version": "changeset version && bun run fix",
    "prepare": "husky",
    "build:release": "bun scripts/build-release.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^6",
    "ultracite": "7.12.2"
  },
  "packageManager": "bun@1.4.2"
}
